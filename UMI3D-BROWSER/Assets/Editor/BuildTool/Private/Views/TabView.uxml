<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <umi3d.browserEditor.BuildTool.TabView style="flex-direction: row; background-color: rgb(72, 53, 53); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; justify-content: space-around; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
        <ui:Button text="Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button__info-view__tab-view" style="border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; height: 25px; flex-grow: 1;" />
        <ui:Button text="Build" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button__build-view__tab-view" style="border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; height: 25px; flex-grow: 1;" />
        <ui:Button text="Scenes" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button__scenes-view__tab-view" style="border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; height: 25px; flex-grow: 1;" />
        <ui:Button text="Features" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button__features-view__tab-view" style="border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; height: 25px; flex-grow: 1;" />
        <ui:Button text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button__settings-view__tab-view" style="border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; height: 25px; flex-grow: 1;" />
    </umi3d.browserEditor.BuildTool.TabView>
</ui:UXML>
